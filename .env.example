# Copy to .env and fill in. .env is git-ignored.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Use "memory" to try the
# app with a throw-away in-memory database (data is lost when the server stops).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=quizduel

# Long random string used to sign login tokens, e.g. run: openssl rand -hex 32
JWT_SECRET=change-me

PORT=4000

# Comma-separated usernames allowed to use the admin panel. If empty, the first
# account ever created becomes the admin.
ADMIN_USERNAMES=

# Set to 0 to disable pulling fresh questions from opentdb.com
FETCH_OPENTDB=1
